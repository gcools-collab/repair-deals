# eBay Browse API (server-side only)
EBAY_CLIENT_ID=<YOUR_EBAY_CLIENT_ID>
EBAY_CLIENT_SECRET=<YOUR_EBAY_CLIENT_SECRET>
EBAY_ENVIRONMENT=production

# Leboncoin bridge
LEBONCOIN_BRIDGE_URL=http://127.0.0.1:8080
LEBONCOIN_BRIDGE_API_KEY=<YOUR_LEBONCOIN_BRIDGE_API_KEY>
LEBONCOIN_REQUEST_TIMEOUT_SECONDS=20
